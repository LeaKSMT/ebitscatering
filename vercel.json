{
    "buildCommand": "cd frontend && npm ci && npm run build",
    "outputDirectory": "frontend/dist",
    "framework": "vite",
    "nodeVersion": "18.x",
    "env": {
        "VITE_API_URL": "https://ebitscatering-production.up.railway.app/api",
        "NODE_ENV": "production"
    },
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}